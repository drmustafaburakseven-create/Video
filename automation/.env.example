# Copy to automation/.env on your own always-on host. Never commit real values.
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
FAL_KEY=
ELEVENLABS_VOICE_ID=allzfJXSadaum3SM2UFr
VIDEO_EDITORIAL_PROVIDER=gemini
# Daily warm-office queue; prepared media inputs live in VIDEO_READY_ROOT.
VIDEO_DAILY_COUNT=3
VIDEO_READY_ROOT=/data/ready-reels
VIDEO_EDITORIAL_ONLY=false
# Optional Claude API route. Claude Code CLI is not installed in this image.
ANTHROPIC_API_KEY=
# Set these to the owner IDs of the mounted folders on a Linux host if different.
VIDEO_UID=1000
VIDEO_GID=1000
